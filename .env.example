# Template only: never add a real key to this tracked file.
# Put real values in the Git-ignored .env and run:
# uv run --env-file .env relay discover
# Relay does not load .env files automatically; uv loads the explicit file.
OPENAI_API_KEY=
RELAY_MODEL=gpt-4.1-mini

# Optional Experiential gateway. Never put a real key in this example file.
# Select with --provider experiential or RELAY_PROVIDER=experiential in private .env.
EXPLABS_API_KEY=
EXPLABS_MODEL=gpt-5.6-luna
